  <body>
    <div class="container">

      <form class="add text-center my-4">
        <label class="text-light">Note Id{{ note.id}}</label>
        <input class="form-control m-auto" type="text" name="add" value="{{ note.title }}" />
        <input class="form-control m-auto" type="text" name="add" value="{{ note.content }}" />
        <input class="form-control m-auto" type="text" name="add" value="{{ note.date }}"/>
        <input class="form-control m-auto" type="text" name="add" value="{{ note.userId }}"/>
        <br />
        <div class="text-center">
          <a href="/v6.5/notes/hbs-test" >
            {{!-- <input type="submit" class="btn btn-light" /> --}}
            <i class="fa fa-arrow-left "></i>
          </a>  
        </div>
      </form>
    </div>
    


    <script src="/form.js"></script>
    
